<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FControl.ActionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FControl Overlay">
    <Grid Background="Transparent">
        <Border
            x:Name="OverlayCard"
            Padding="18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderThickness="0"
            CornerRadius="14"
            Opacity="0">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    Width="36"
                    Height="36"
                    VerticalAlignment="Top"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="18">
                    <FontIcon
                        x:Name="OverlayIcon"
                        FontSize="19"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE767;" />
                </Grid>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock
                        x:Name="OverlayTitleText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="OverlayLevelPanel" Spacing="4">
                        <Slider
                            x:Name="OverlayLevelSlider"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="OverlayLevelSlider_ValueChanged" />
                        <TextBlock
                            x:Name="OverlayPercentText"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="OverlayMessageText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
