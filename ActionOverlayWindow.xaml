<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FControl.ActionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FControl Overlay">
    <Grid
        x:Name="OverlayRoot"
        Background="Transparent"
        VerticalAlignment="Center">
        <Border
            x:Name="OverlayCard"
            Padding="18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderThickness="0"
            CornerRadius="14"
            Opacity="0">
            <Grid
                x:Name="OverlayContentGrid"
                MinHeight="76">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="38"
                    Height="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="29">
                    <FontIcon
                        x:Name="OverlayIcon"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="18"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE767;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <TextBlock
                        x:Name="OverlayTitleText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <Grid x:Name="OverlayLevelPanel" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="OverlayLevelSlider"
                            IsThumbToolTipEnabled="False"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="OverlayLevelSlider_ValueChanged" />
                        <TextBlock
                            x:Name="OverlayPercentText"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <TextBlock
                        x:Name="OverlayMessageText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
