<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FControl.Pages.AdvancedSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="高级设置" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="配置后台运行、启动行为、兼容性选项与脚本运行环境。" />
            </StackPanel>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <ToggleSwitch
                        x:Name="CompatibilityModeSwitch"
                        Header="开启兼容模式"
                        Toggled="AdvancedSwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="StartupSwitch"
                        Header="开机自启"
                        Toggled="AdvancedSwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="ColdStartSwitch"
                        Header="静默自启"
                        OffContent="开机后显示设置窗口"
                        OnContent="开机后仅后台运行"
                        Toggled="AdvancedSwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="KeepTrayIconSwitch"
                        Header="保留状态栏图标（推荐保留）"
                        Toggled="AdvancedSwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="BackgroundPerformanceModeSwitch"
                        Header="后台性能模式"
                        OffContent="最小化到托盘时不调整资源优先级"
                        OnContent="最小化到托盘时降低资源占用"
                        Toggled="AdvancedSwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="DebugLogSwitch"
                        Header="开启调试日志（默认关闭）"
                        Toggled="AdvancedSwitch_Toggled" />
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="脚本运行环境" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="检测 Python、Node.js 环境；检测成功后会把路径填入自定义路径输入框。" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="DetectRuntimesButton_Click" Content="重新检测" />
                    </Grid>

                    <InfoBar x:Name="RuntimeInfoBar" IsOpen="False" />

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Python" />
                        <TextBox x:Name="PythonPathBox" Grid.Column="1" Header="自定义路径" TextChanged="RuntimePathBox_TextChanged" />
                        <TextBlock x:Name="PythonStatusText" Grid.Column="2" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="未检测" TextWrapping="Wrap" />
                        <Button Grid.Column="3" VerticalAlignment="Bottom" Click="TestPythonButton_Click" Content="测试" />
                        <Button Grid.Column="4" VerticalAlignment="Bottom" Click="ClearPythonPathButton_Click" Content="清空" />

                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Node.js" />
                        <TextBox x:Name="NodePathBox" Grid.Row="1" Grid.Column="1" Header="自定义路径" TextChanged="RuntimePathBox_TextChanged" />
                        <TextBlock x:Name="NodeStatusText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="未检测" TextWrapping="Wrap" />
                        <Button Grid.Row="1" Grid.Column="3" VerticalAlignment="Bottom" Click="TestNodeButton_Click" Content="测试" />
                        <Button Grid.Row="1" Grid.Column="4" VerticalAlignment="Bottom" Click="ClearNodePathButton_Click" Content="清空" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="运行日志" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="开发调试功能会实时显示本次运行期间的热键、动作和配置日志。" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Click="ClearLogButton_Click" Content="清空日志" />
                <Button Click="ExportLogButton_Click" Content="导出日志文件" />
            </StackPanel>

            <Border
                Height="360"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled"
                    ZoomMode="Disabled">
                    <ItemsControl
                        x:Name="LogListView"
                        ItemsSource="{x:Bind LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Padding="0,4"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Text="{Binding}"
                                    TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <InfoBar
                x:Name="ExportInfoBar"
                IsOpen="False"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
