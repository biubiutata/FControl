<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FControl.Pages.AdvancedSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="高级设置" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="配置后台运行、启动行为与兼容性选项。" />
            </StackPanel>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <ToggleSwitch
                        x:Name="CompatibilityModeSwitch"
                        Header="开启兼容模式"
                        Toggled="AdvancedSwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="StartupSwitch"
                        Header="开机自启"
                        Toggled="AdvancedSwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="ColdStartSwitch"
                        Header="静默自启"
                        OffContent="开机后显示设置窗口"
                        OnContent="开机后仅后台运行"
                        Toggled="AdvancedSwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="KeepTrayIconSwitch"
                        Header="保留状态栏图标（推荐保留）"
                        Toggled="AdvancedSwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="DebugLogSwitch"
                        Header="开启调试日志（默认关闭）"
                        Toggled="AdvancedSwitch_Toggled" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="运行日志" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="开发调试功能会实时显示本次运行期间的热键、动作和配置日志。" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Click="ClearLogButton_Click" Content="清空日志" />
                <Button Click="ExportLogButton_Click" Content="导出日志文件" />
            </StackPanel>

            <Border
                Height="360"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ListView
                    x:Name="LogListView"
                    ItemsSource="{x:Bind LogLines}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                Text="{Binding}"
                                TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <InfoBar
                x:Name="ExportInfoBar"
                IsOpen="False"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
